        "jsCode": "const MIN_TITLE_LENGTH = 25;\nconst MIN_CONTENT_LENGTH = 120;\nconst MIN_CONTENT_WORDS = 20;\n\nconst BOILERPLATE_PHRASES = [\n  \"read more\",\n  \"click here\",\n  \"subscribe now\",\n  \"subscribe to read\",\n  \"sign up\",\n  \"watch here\",\n  \"follow us\",\n  \"follow for more\",\n  \"stay updated\",\n  \"download app\",\n  \"share this article\",\n  \"for more updates\",\n  \"also read\",\n  \"advertisement\",\n  \"sponsored\",\n];\n\nfunction normalizeText(value) {\n  return String(value || \"\")\n    .replace(/<[^>]*>/g, \" \")\n    .replace(/&nbsp;|&#160;/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction wordCount(text) {\n  const words = normalizeText(text).split(\" \").filter(Boolean);\n  return words.length;\n}\n\nfunction looksLikeBoilerplate(text) {\n  const t = normalizeText(text).toLowerCase();\n  return BOILERPLATE_PHRASES.some((p) => t.includes(p));\n}\n\nfunction hasEnoughUniqueWords(title, content) {\n  const tWords = new Set(\n    normalizeText(title)\n      .toLowerCase()\n      .split(\" \")\n      .filter((w) => w.length > 2)\n  );\n\n  const cWords = new Set(\n    normalizeText(content)\n      .toLowerCase()\n      .split(\" \")\n      .filter((w) => w.length > 2)\n  );\n\n  if (tWords.size === 0 || cWords.size === 0) return false;\n\n  let overlap = 0;\n  for (const w of tWords) {\n    if (cWords.has(w)) overlap++;\n  }\n\n  // Require at least some overlap, but not too much repetition-only content\n  return overlap >= 1;\n}\n\nreturn items.filter((item) => {\n  const title = normalizeText(item.json.title);\n  const content = normalizeText(item.json.content);\n  const link = normalizeText(item.json.link);\n\n  if (!title || !content || !link) return false;\n\n  if (title.length < MIN_TITLE_LENGTH) return false;\n  if (content.length < MIN_CONTENT_LENGTH) return false;\n  if (wordCount(content) < MIN_CONTENT_WORDS) return false;\n\n  if (looksLikeBoilerplate(title) || looksLikeBoilerplate(content)) return false;\n\n  if (!hasEnoughUniqueWords(title, content)) return false;\n\n  return true;\n});"
